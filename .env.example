# Public application URL
NEXT_PUBLIC_SITE_URL=https://togetherforever.id

# Neon pooled connection — use this for the Next.js application at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require

# Neon direct/unpooled connection — use this for Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require

# Generate with a cryptographically secure random value of at least 32 bytes.
SESSION_SECRET=replace-with-a-long-random-secret

# Admin credentials. ADMIN_PIN must contain exactly four digits.
ADMIN_USERNAME=admin
ADMIN_PIN=1234
